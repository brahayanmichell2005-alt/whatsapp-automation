# =====================================================================
# Variables de entorno. En Vercel se cargan en:
#   Project -> Settings -> Environment Variables
# En local, copia este archivo a `.env` y completa los valores.
# NUNCA subas `.env` a GitHub (ya esta en .gitignore).
# =====================================================================

NODE_ENV=development

# --- Base de datos: Supabase (PostgreSQL) ---
# Supabase -> boton "Connect" -> "Transaction pooler" (puerto 6543).
# Formato: postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Si tu password tiene @ : / # ? codificalos (ej. @ -> %40).
DATABASE_URL=

# --- Seguridad (genera valores largos y aleatorios) ---
# Para generar uno:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Secreto que debe enviar Supabase pg_cron a /api/cron/tick (mismo valor en database/cron.sql)
CRON_SECRET=
# Secreto que debe enviar Evolution API en la cabecera x-webhook-token (recomendado)
WEBHOOK_SECRET=

# --- Administrador inicial del panel (se crea en la primera peticion) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Evolution API (debe estar alojada en un servidor propio, ver README) ---
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
# URL publica de este backend para el webhook, ej: https://tu-proyecto.vercel.app/api/webhooks/whatsapp
WEBHOOK_URL=

# --- IA opcional. AI_PROVIDER: none | ollama | openai | anthropic ---
# (ollama necesita un servidor propio; en Vercel usa openai o anthropic)
AI_PROVIDER=none
AI_MODEL=
OLLAMA_BASE_URL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Horario de atencion y limites de envio ---
START_TIME=08:00
END_TIME=20:00
TIMEZONE=America/Lima

MIN_DELAY_SECONDS=10
MAX_DELAY_SECONDS=30

MAX_MESSAGES_PER_MINUTE=20
MAX_MESSAGES_PER_HOUR=200
MAX_MESSAGES_PER_DAY=1000
MAX_CONCURRENT_SENDS=3

MAX_RETRIES=3

# --- Opcionales ---
# DB_POOL_MAX=3           conexiones por instancia serverless
# DB_SSL=true             false solo si usas un Postgres local
# CRON_BUDGET_MS=45000    tiempo maximo de envio por llamada del cron (< 60000)
# CORS_ORIGIN=            origenes permitidos, separados por coma (vacio = todos)
# LOG_LEVEL=info
